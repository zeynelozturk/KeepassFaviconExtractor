<Project>
  <Target Name="RunTestsOnBuild"
		  AfterTargets="Build"
		  Condition="'$(MSBuildProjectName)' == 'KeepassFaviconExtractor.Tests' and Exists('$(TargetPath)') and ( '$(RunOnBuild)' == 'true' or ( '$(RunOnBuild)' == '' and '$(Configuration)' == 'Release' ) )">
	<Message Importance="high" Text="RunOnBuild is enabled. Running tests for $(MSBuildProjectName)..." />
	<Exec Condition="Exists('$(DevEnvDir)CommonExtensions\Microsoft\TestWindow\vstest.console.exe')"
		  Command="&quot;$(DevEnvDir)CommonExtensions\Microsoft\TestWindow\vstest.console.exe&quot; &quot;$(TargetPath)&quot; /logger:trx /TestAdapterPath:&quot;$(MSTestAdapterPath)&quot;"
		  StandardOutputImportance="high"
		  StandardErrorImportance="high" />
	<Exec Condition="!Exists('$(DevEnvDir)CommonExtensions\Microsoft\TestWindow\vstest.console.exe')"
		  Command="vstest.console.exe &quot;$(TargetPath)&quot; /logger:trx /TestAdapterPath:&quot;$(MSTestAdapterPath)&quot;"
		  StandardOutputImportance="high"
		  StandardErrorImportance="high" />
	<Message Importance="high" Text="RunOnBuild tests passed for $(MSBuildProjectName)." />
  </Target>

  <Target Name="ReportRunOnBuildStatus"
		  AfterTargets="Build"
		  Condition="'$(MSBuildProjectName)' == 'KeepassFaviconExtractor.Tests'">
	<Message Importance="high" Text="RunOnBuild=$(RunOnBuild); Configuration=$(Configuration); Project=$(MSBuildProjectName)" />
	<Message Importance="high" Text="DevEnvDir=$(DevEnvDir)" />
	<Message Importance="high" Text="MSTestAdapterPath=$(MSTestAdapterPath)" />
	<Message Importance="high" Condition="'$(RunOnBuild)' == 'true' or ( '$(RunOnBuild)' == '' and '$(Configuration)' == 'Release' )" Text="RunOnBuild=true for $(MSBuildProjectName)." />
	<Message Importance="high" Condition="'$(RunOnBuild)' != 'true' and ( '$(RunOnBuild)' != '' or '$(Configuration)' != 'Release' )" Text="RunOnBuild is disabled for $(MSBuildProjectName)." />
  </Target>

  <Target Name="PackagePluginArtifacts"
		  AfterTargets="Build"
		  Condition="'$(PackagePluginOnBuild)' == 'true' and '$(Configuration)' == 'Release' and '$(MSBuildProjectName)' == 'KeepassFaviconExtractor'">
	<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\build-release.ps1&quot; -Configuration $(Configuration) -SkipBuild -KeePassExePath &quot;$(KeePassDir)\KeePass.exe&quot;" />
  </Target>
</Project>
