<Project>
	<Target Name="ValidateNativeWebpBinaries"
		  BeforeTargets="BeforeBuild"
		  Condition="'$(MSBuildProjectName)' == 'KeepassFaviconExtractor' and '$(SkipNativeWebpCheck)' != 'true' and '$(DesignTimeBuild)' != 'true'">
	<Error Condition="!Exists('$(MSBuildProjectDirectory)\native\x86\libwebp.dll')"
		   Text="Missing native dependency: 'native\x86\libwebp.dll'. Run '.\scripts\bootstrap-native-webp.ps1' or build with /p:SkipNativeWebpCheck=true." />
	<Error Condition="!Exists('$(MSBuildProjectDirectory)\native\x86\libsharpyuv.dll')"
		   Text="Missing native dependency: 'native\x86\libsharpyuv.dll'. Run '.\scripts\bootstrap-native-webp.ps1' or build with /p:SkipNativeWebpCheck=true." />
	<Error Condition="!Exists('$(MSBuildProjectDirectory)\native\x64\libwebp.dll')"
		   Text="Missing native dependency: 'native\x64\libwebp.dll'. Run '.\scripts\bootstrap-native-webp.ps1' or build with /p:SkipNativeWebpCheck=true." />
	<Error Condition="!Exists('$(MSBuildProjectDirectory)\native\x64\libsharpyuv.dll')"
		   Text="Missing native dependency: 'native\x64\libsharpyuv.dll'. Run '.\scripts\bootstrap-native-webp.ps1' or build with /p:SkipNativeWebpCheck=true." />
  </Target>

  <Target Name="RunTestsOnBuild"
		  AfterTargets="Build"
		  Condition="'$(MSBuildProjectName)' == 'KeepassFaviconExtractor.Tests' and Exists('$(TargetPath)') and ( '$(RunOnBuild)' == 'true' or ( '$(RunOnBuild)' == '' and '$(Configuration)' == 'Release' ) )">
	<Message Importance="high" Text="RunOnBuild is enabled. Running tests for $(MSBuildProjectName)..." />
	<Exec Condition="Exists('$(DevEnvDir)CommonExtensions\Microsoft\TestWindow\vstest.console.exe')"
		  Command="&quot;$(DevEnvDir)CommonExtensions\Microsoft\TestWindow\vstest.console.exe&quot; &quot;$(TargetPath)&quot; /logger:trx /TestAdapterPath:&quot;$(FaviconExtractorMSTestAdapterPath)&quot;"
		  StandardOutputImportance="high"
		  StandardErrorImportance="high" />
	<Exec Condition="!Exists('$(DevEnvDir)CommonExtensions\Microsoft\TestWindow\vstest.console.exe')"
		  Command="vstest.console.exe &quot;$(TargetPath)&quot; /logger:trx /TestAdapterPath:&quot;$(FaviconExtractorMSTestAdapterPath)&quot;"
		  StandardOutputImportance="high"
		  StandardErrorImportance="high" />
	<Message Importance="high" Text="RunOnBuild tests passed for $(MSBuildProjectName)." />
  </Target>

  <Target Name="ReportRunOnBuildStatus"
		  AfterTargets="Build"
		  Condition="'$(MSBuildProjectName)' == 'KeepassFaviconExtractor.Tests'">
	<Message Importance="high" Text="RunOnBuild=$(RunOnBuild); Configuration=$(Configuration); Project=$(MSBuildProjectName)" />
	<Message Importance="high" Text="DevEnvDir=$(DevEnvDir)" />
	<Message Importance="high" Text="FaviconExtractorMSTestAdapterPath=$(FaviconExtractorMSTestAdapterPath)" />
	<Message Importance="high" Condition="'$(RunOnBuild)' == 'true' or ( '$(RunOnBuild)' == '' and '$(Configuration)' == 'Release' )" Text="RunOnBuild=true for $(MSBuildProjectName)." />
	<Message Importance="high" Condition="'$(RunOnBuild)' != 'true' and ( '$(RunOnBuild)' != '' or '$(Configuration)' != 'Release' )" Text="RunOnBuild is disabled for $(MSBuildProjectName)." />
  </Target>

  <Target Name="PackagePluginArtifacts"
		  AfterTargets="Build"
		  Condition="'$(PackagePluginOnBuild)' == 'true' and '$(Configuration)' == 'Release' and '$(MSBuildProjectName)' == 'KeepassFaviconExtractor'">
	<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\scripts\build-release.ps1&quot; -Configuration $(Configuration) -SkipBuild -KeePassExePath &quot;$(KeePassDir)\KeePass.exe&quot;" />
  </Target>

  <Target Name="WarnWhenUpdateTxtVersionDiffersFromAssemblyVersion"
		  AfterTargets="Build"
		  Condition="'$(MSBuildProjectName)' == 'KeepassFaviconExtractor' and '$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">
	<PropertyGroup>
	  <_UpdateTxtVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\update.txt')), 'FaviconExtractor:([^\r\n]+)').Groups[1].Value)</_UpdateTxtVersion>
	  <_AssemblyVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\Properties\AssemblyInfo.cs')), 'AssemblyVersion\(&quot;([^&quot;]+)&quot;\)').Groups[1].Value)</_AssemblyVersion>
	</PropertyGroup>
	<Warning Condition="'$(_UpdateTxtVersion)' != '' and '$(_AssemblyVersion)' != '' and '$(_UpdateTxtVersion)' != '$(_AssemblyVersion)'"
			 Text="Release reminder: update.txt version '$(_UpdateTxtVersion)' does not match AssemblyVersion '$(_AssemblyVersion)'. Update update.txt before publishing a release." />
  </Target>
</Project>
